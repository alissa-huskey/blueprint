{
    "name": "${VENDOR}/${SMOOSHED_NAME}",
    "type": "phpbb-extension",
    "description": "${SUMMARY}",
    "version": "0.1.0",
    "time": "2025-06-23",
    "keywords": ["phpbb", "extension"],
    "license": "GPL-2.0-only",
    "authors": [ { "name": "Chloe" } ],
    "require": {
        "php": ">=5.4.0",
        "composer/installers": "~1.0"
    },
    "require-dev": {
        "phpbb/epv": "*",
        "squizlabs/php_codesniffer": "*",
        "phpunit/phpunit": "^9.0.0",
        "php-stubs/generator": "*"
    },
    "extra": {
        "display-name": "${TITLE_NAME}",
        "soft-require": {
            "phpbb/phpbb": "~3.2"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
   "autoload": {
     "psr-4": {
       "${VENDOR}\\${SMOOSHED_NAME}\\": "./"
     }
   },
   "autoload-dev": {
     "psr-4": {
       "${VENDOR}\\${SMOOSHED_NAME}\\tests\\": "tests/",
       "phpbb\\": "tests/stubs/phpbb/"
     }
   }
}
