#!/usr/bin/env python3

"""Create a virtual environment, install dependencies and run a script."""

from pathlib import Path
import sys
import subprocess
import venv

VENV_DIR = os.path.join(os.path.dirname(__file__), '.venv')


def in_venv():
    return sys.prefix != sys.base_prefix


def ensure_venv():
    if not os.path.exists(VENV_DIR):
        print('Creating virtual environment...')
        venv.create(VENV_DIR, with_pip=True)
    if not os.path.exists(PYTHON_BIN):
        raise RuntimeError(f'Python binary not found in venv: {PYTHON_BIN}')


def install_dependencies():
    print(f'Installing required module: {REQUIRED_MODULE}')
    subprocess.check_call([PYTHON_BIN, '-m', 'pip', 'install', REQUIRED_MODULE])


def rerun_in_venv():
    print('Re-running script inside venv...')
    subprocess.check_call([PYTHON_BIN, __file__] + sys.argv[1:])
    sys.exit()


# Bootstrap
if not in_venv():
    ensure_venv()
    install_dependencies()
    rerun_in_venv()

# ---- Actual script logic below ----
import toml

print('Successfully imported toml!')
# your actual logic here

