{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "language-toolstack.schema.json",
  "$ref": "base.schema.json",
  "title": "Blueprint language-toolstack schema.",
  "required": ["name", "description", "version", "type", "stack"],
  "properties": {
    "type": { "constant": "language-toolstack" },
    "stack": {
      "description": "Toolstack specifications. (For type: language-toolstack)",
      "$comment": "Annotations",
      "type": "object",
      "additionalProperties": { "$ref": "base.schema.json#nonEmptyString" },
      "required": ["language"],
      "properties": {
        "language": {
          "description": "Primary language this project is written in.",
          "examples": ["python"],
          "$ref": "base.schema.json#nonEmptyString"
        },
        "dependencies": {
          "description": "Dependency management tool.",
          "examples": ["poetry"],
          "$ref": "base.schema.json#nonEmptyString"
        },
        "tests": {
          "description": "Testing framework.",
          "examples": ["pytest"],
          "$ref": "base.schema.json#nonEmptyString"
        },
        "linter": {
          "description": "Linter.",
          "examples": ["flake8"],
          "$ref": "base.schema.json#nonEmptyString"
        },
        "formatter": {
          "description": "Formatter",
          "examples": ["black"],
          "$ref": "base.schema.json#nonEmptyString"
        }
      }
    },
    "dependency-commands": {
        "description": "Commands to add dependencies.",
        "examples": [
          {
            "main": ["poerty", "add"],
            "dev": ["poetry", "add", "--group", "dev"]
          }
        ],
        "type": "object",
        "properties": {
          "main": {
            "type": "array",
            "items": {"$rev": "#nonEmptyString"},
            "minItems": 1
          },
          "dev": {
            "type": "array",
            "items": {"$rev": "#nonEmptyString"},
            "minItems": 1
          }
        }
    }
  }
}
