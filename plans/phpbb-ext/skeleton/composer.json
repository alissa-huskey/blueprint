{
    "name": "{{ VENDOR | to_smooshed_case }}/{{ NAME | to_smooshed_case }}",
    "type": "phpbb-extension",
    "description": "{{ SUMMARY }}",
    "version": "0.1.0",
    "keywords": ["phpbb", "extension"],
    "license": "GPL-2.0-only",
    "authors": [ { "name": "{{ AUTHOR }}" } ],
    "require": {
        "php": "{{ PHP_CONSTRAINT }}",
        "composer/installers": "~1.0"
    },
    "require-dev": {
        "phpbb/epv": "*",
        "squizlabs/php_codesniffer": "*",
        "phpunit/phpunit": "^9.0.0",
        "php-stubs/generator": "*"
    },
    "extra": {
        "display-name": "{{ NAME | to_title_case }}",
        "soft-require": {
            "phpbb/phpbb": "~3.2"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
   "autoload": {
     "psr-4": {
       "{{ VENDOR | to_smooshed_case }}\\{{ NAME | to_smooshed_case }}\\": "./"
     }
   },
   "autoload-dev": {
     "psr-4": {
       "{{ VENDOR | to_smooshed_case }}\\{{ NAME | to_smooshed_case }}\\tests\\": "tests/",
       "phpbb\\": "tests/stubs/phpbb/"
     }
   }
}
