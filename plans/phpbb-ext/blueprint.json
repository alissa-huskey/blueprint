{
  "name": "phpbb-ext",
  "title": "phpBB Extension",
  "description": "phpBB Extension",
  "version": "0.1.0",
  "type": "extension",
  "parent": "basic",
  "stack": {
    "language": "php",
    "application": "phpBB",
    "dependencies": "composer",
    "tests": "phpunit",
    "linter": "phpcs"
  },
  "requirements": [ "php", "composer" ],
  "project-dir": "phpbb-{{ NAME | to_kebab_case }}",
  "options": {
    "phpv": {
      "default": "7.4.33",
      "help": "PHP Version"
    },
    "php-constraint": {
      "default": ">=7.3",
      "help": "PHP Version Constraint"
    }
  },
  "arguments": {
    "vendor": {},
    "name": {}
  },
  "after": [
    { 
      "cmd": ["composer", "install"],
      "env_path": ["/opt/homebrew/opt/php@7.4/bin"]
    },
    {
      "cmd": [
        "cp",
        "{{ PLANS_ROOT }}/after/CodeSniffer.conf",
        "vendor/squizlabs/php_codesniffer/"
      ]
    }
  ]
}
