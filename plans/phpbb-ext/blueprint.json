{
  "name": "phpbb-ext",
  "title": "phpBB Extension",
  "description": "phpBB Extension",
  "version": "0.1.0",
  "type": "extension",
  "parent": "php-composer",
  "project-dir": "phpbb-${DASH_NAME}",
  "options": {
    "phpv": {
      "default": "7.4.33",
      "help": "PHP Version",
      "hidden": true
    },
    "php-constraint": {
      "default": ">=7.3",
      "help": "PHP Version Constraint",
      "hidden": true
    },
    "project-type": { 
      "default": "phpbb-extension",
      "help": "Composer project type",
      "hidden": true
    }
  }
}
