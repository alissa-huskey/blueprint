{
    "name": "{{ VENDOR | to_kebab_case }}/{{ NAME | to_kebab_case }}",
    "description": "{{ SUMMARY }}",
    "version": "{{ VERSION }}",
    "type": "{{ PROJECT_TYPE }}",
    "license": "{{ LICENSE }}",
    "authors": [ { "name": "{{ AUTHOR }}" } ],
    "keywords": [],
    "require": {
        "php": "{{ PHP_CONSTRAINT }}",
        "composer/installers": "~1.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "*",
        "phpunit/phpunit": "^9.0.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
   "autoload": {
     "psr-4": {
       "{{ VENDOR | to_pascal_case }}\\{{ NAME | to_pascal_case }}\\": "./src"
     }
   },
   "autoload-dev": {
     "psr-4": {
       "{{ VENDOR | to_pascal_case | to_pascal_case }}\\{{ NAME | to_pascal_case }}\\Tests\\": "tests/",
       "phpbb\\": "tests/stubs/phpbb/"
     }
   }
}
